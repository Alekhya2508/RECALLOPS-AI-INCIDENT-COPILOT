# Frontend
VITE_API_URL=/api

# Backend database. SQLite is supported for a zero-dependency local demo.
# Production example:
# DATABASE_URL=postgresql+psycopg://recallops:recallops@localhost:5432/recallops
DATABASE_URL=sqlite:///./recallops.db
RECALLOPS_DEMO_MODE=true
FRONTEND_ORIGINS=http://localhost:8443,http://localhost:3000

# Hindsight: "local" uses the durable RecallOps database; "remote" calls Hindsight.
HINDSIGHT_MODE=local
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=recallops-incidents
HINDSIGHT_ALLOW_DB_FALLBACK=true

# Groq/OpenAI-compatible LLM. Empty key enables the safe deterministic fallback.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
